{
  "name": "starlight-view-modes-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Starlight plugin to add view mode capabilities to your documentation website.",
  "homepage": "https://github.com/trueberryless-org/starlight-view-modes",
  "bugs": {
    "url": "https://github.com/trueberryless-org/starlight-view-modes/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/trueberryless-org/starlight-view-modes.git"
  },
  "license": "MIT",
  "author": "trueberryless <trueberryless@gmail.com> (https://felixs.dev)",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter starlight-view-modes-docs build",
    "check": "pnpm --filter starlight-view-modes-docs astro sync && astro check --noSync",
    "dev": "pnpm --filter starlight-view-modes-docs dev",
    "format": "prettier . --write --cache --ignore-unknown",
    "version": "pnpm changeset version && pnpm i --no-frozen-lockfile"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "astro": "^7.3.5",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.28.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
