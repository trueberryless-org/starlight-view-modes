---
import type { StarlightRouteData } from "@astrojs/starlight/route-data";

interface Props {
  entries: StarlightRouteData["sidebar"];
}

const { entries } = Astro.props;
const links = entries.filter((entry) => entry.type === "link");
const groups = entries.filter((entry) => entry.type === "group");
---

{links.length > 0 && (
  <ul class="starlight-view-modes-presentation-contents-pages">
    {links.map((link) => (
      <li>
        <a
          href={link.href}
          aria-current={link.isCurrent ? "page" : undefined}
          {...link.attrs}
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
)}
{groups.map((group) => (
  <section class="starlight-view-modes-presentation-contents-group">
    <h3>{group.label}</h3>
    <Astro.self entries={group.entries} />
  </section>
))}
