---
import {
  getPresentationNextPage,
  getPresentationRouteSequence,
} from "../../libs/presentation";
import { SequenceClassName } from "../../libs/sequence";

interface Props {
  slides: number;
}

const { starlightRoute } = Astro.locals;
const sequence = getPresentationRouteSequence(starlightRoute);
const hasNextPageSlide = getPresentationNextPage(starlightRoute) !== undefined;
---

{sequence && (
  <div
    class={SequenceClassName}
    hidden
    data-href={sequence.href}
    data-next={sequence.next}
    data-previous={sequence.previous}
    data-sequence={sequence.id}
    data-sequence-index={sequence.index}
    data-slides={Astro.props.slides + (hasNextPageSlide ? 1 : 0)}
  />
)}
