---
import Icon from "../ui/Icon.astro";

function getStrokeIcon(paths: string): string {
  return `<g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${paths}</g>`;
}

const actions = [
  {
    name: "contents",
    label: Astro.locals.t("starlightViewModes.presentationMode.contents"),
    icon: '<path d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" />',
  },
  {
    name: "overview",
    label: Astro.locals.t("starlightViewModes.presentationMode.overview"),
    icon: '<path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z" />',
  },
  {
    name: "speaker-view",
    label: Astro.locals.t("starlightViewModes.presentationMode.speakerView"),
    icon: '<path d="M4 5h16v11H4zM8 20h8M12 16v4M8 9h8M8 12h5" />',
  },
  {
    name: "fullscreen",
    label: Astro.locals.t("starlightViewModes.presentationMode.fullscreen"),
    icon: '<path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" />',
  },
  {
    name: "print",
    label: Astro.locals.t("starlightViewModes.presentationMode.print"),
    icon: '<path d="M12 4v11M7.5 10.5 12 15l4.5-4.5M5 20h14" />',
  },
];
---

<nav
  class="starlight-view-modes-presentation-toolbar not-content"
  aria-label={Astro.locals.t("starlightViewModes.presentationMode.controls")}
>
  {actions.map((action) => (
    <button type="button" data-action={action.name} title={action.label}>
      <Icon set:html={getStrokeIcon(action.icon)} />
      <span class="sr-only">{action.label}</span>
    </button>
  ))}
</nav>
