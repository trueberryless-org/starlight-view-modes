---
import type { CollectionEntry } from "astro:content";

import { getPresentation } from "../../libs/presentation";
import type { PageDescriptions } from "../../libs/presentationMode";
import PresentationContents from "./PresentationContents.astro";
import PresentationMenu from "./PresentationMenu.astro";
import PresentationNextPage from "./PresentationNextPage.astro";
import PresentationSlide from "./PresentationSlide.astro";
import PresentationToolbar from "./PresentationToolbar.astro";

interface Props {
  descriptions: PageDescriptions;
  entry: CollectionEntry<"docs">;
}

const { deck, options } = getPresentation(
  await Astro.slots.render("default"),
  Astro.props.entry
);
---

<starlight-view-modes-presentation data-options={JSON.stringify(options)}>
  <div class="reveal">
    <div class="slides">
      {deck.stacks.map((stack) =>
        stack.length > 1 ? (
          <section>
            {stack.map((slide) => (
              <PresentationSlide slide={slide} />
            ))}
          </section>
        ) : (
          stack.map((slide) => <PresentationSlide slide={slide} />)
        )
      )}
      <PresentationNextPage />
    </div>
  </div>
  <nav
    class="starlight-view-modes-presentation-breadcrumbs not-content"
    aria-label={Astro.locals.t(
      "starlightViewModes.presentationMode.breadcrumbs"
    )}
  >
    <ol></ol>
  </nav>
  <PresentationMenu />
  <PresentationToolbar />
  <PresentationContents
    descriptions={Astro.props.descriptions}
    outline={deck.outline}
  />
</starlight-view-modes-presentation>

<script>
  import { initializePresentation } from "../../libs/deck";

  class StarlightViewModesPresentation extends HTMLElement {
    constructor() {
      super();

      void initializePresentation(this);
    }
  }

  customElements.define(
    "starlight-view-modes-presentation",
    StarlightViewModesPresentation
  );
</script>
