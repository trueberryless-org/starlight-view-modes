---
import { getSearchData } from "../../libs/search";

const { mode, shortcuts } = await getSearchData(Astro.url.pathname);
---

<starlight-view-modes-search
  data-mode={mode}
  data-shortcuts={JSON.stringify(shortcuts)}
></starlight-view-modes-search>

<script>
  import {
    parseShortcuts,
    prefixLinksWithMode,
    switchModeWithShortcut,
  } from "../../libs/navigation";

  class StarlightViewModesSearch extends HTMLElement {
    constructor() {
      super();

      const shortcuts = parseShortcuts(this.dataset["shortcuts"]);

      if (shortcuts.length > 0) {
        window.addEventListener("keydown", (event) =>
          switchModeWithShortcut(event, shortcuts)
        );
      }

      prefixLinksWithMode(
        document.querySelector("#starlight__search"),
        this.dataset["mode"]
      );
    }
  }

  customElements.define(
    "starlight-view-modes-search",
    StarlightViewModesSearch
  );
</script>

<style>
  starlight-view-modes-search {
    display: none;
  }
</style>
