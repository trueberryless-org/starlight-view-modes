---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";

import Renderer from "../components/content/Renderer.astro";
import RenderHtmlWithRehype from "../components/content/RenderHtmlWithRehype.astro";
import { getZenModePage, getZenModeStaticPaths } from "../libs/zenMode";
import "../styles/zen-mode.css";

export const getStaticPaths = (() =>
  getZenModeStaticPaths()) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry, isFallback } = Astro.props;
const { classes, props } = await getZenModePage(entry, isFallback);
---

<StarlightPage {...props}>
  <div class:list={classes}>
    <RenderHtmlWithRehype>
      <Renderer entry={entry} />
    </RenderHtmlWithRehype>
  </div>
</StarlightPage>
