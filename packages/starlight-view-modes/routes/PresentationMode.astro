---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";

import Renderer from "../components/content/Renderer.astro";
import Presentation from "../components/presentation/Presentation.astro";
import {
  getPageDescriptions,
  getPresentationModePageProps,
  getPresentationModeStaticPaths,
} from "../libs/presentationMode";
import "../styles/presentation-mode.css";

export const getStaticPaths = (() =>
  getPresentationModeStaticPaths()) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry, isFallback } = Astro.props;
const descriptions = await getPageDescriptions();
---

<StarlightPage {...getPresentationModePageProps(entry, isFallback)}>
  <Presentation descriptions={descriptions} entry={entry}>
    <Renderer entry={entry} />
  </Presentation>
</StarlightPage>
